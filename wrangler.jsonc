{
  // Cloudflare Workers 配置：同一个项目既发布静态站点，也提供后端 API。
  //
  // - assets：npm run build 产出的 dist/（主页面 + /verify/ + /admin/）
  // - main：Worker 入口，处理 /admin/api/* 与 /verify/cap/*，未命中静态资源的其它路径返回 404
  // - nodejs_compat：capjs-core 内部使用 node:crypto 与 node:zlib（instrumentation 的
  //   deflate），在 Workers 上必须开启这个兼容标志
  //
  // 部署：npx wrangler deploy（本仓库接的是 git 自动部署，推送即发布）
  // 密钥：npx wrangler secret put CAP_SECRET        ← 不要写进本文件
  //       npx wrangler secret put ADMIN_PASSWORD    ← 后台登录密码
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenithliteaura-github-io",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "kv_namespaces": [
    {
      // 绑定名必须保持 ADMIN_KV：worker/index.ts 与 src/server-shared.ts 都按这个名字取用
      "binding": "ADMIN_KV",
      "id": "5855d7f8c9444bb7a3f3957b68f0b98f",
      // remote: true 只影响 `wrangler dev`（本地开发直连线上 KV）。
      // 注意它意味着 wrangler dev 会真的读写生产 KV；我们日常用的是 `npm run dev`
      // （Vite 中间件 + 内存 KV），不受这个字段影响。
      "remote": true
    }
  ]
}